# Provider Selection (change these to switch providers)
STT_PROVIDER=google  # google | assemblyai | whisper
TTS_PROVIDER=gtts    # gtts | google | cartesia | elevenlabs
LLM_PROVIDER=groq    # groq | openai | anthropic | gemini
WHATSAPP_PROVIDER=twilio  # twilio | greenapi

# Google API (for STT/TTS)
GOOGLE_API_KEY=your-google-api-key

# Groq (Free LLM - 14,400 requests/day)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# AssemblyAI (optional STT)
ASSEMBLYAI_API_KEY=your-assemblyai-key

# Whisper (local, no key needed)
WHISPER_MODEL=base

# Cartesia TTS (optional)
CARTESIA_API_KEY=your-cartesia-key

# Twilio (Phone + WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Green API (free WhatsApp alternative)
GREENAPI_INSTANCE_ID=your-instance-id
GREENAPI_TOKEN=your-token

# Language
STT_LANGUAGE=en-IN
TTS_LANGUAGE=en

# Database
DATABASE_URL=sqlite:///./orders.db

# Application
WEBHOOK_BASE_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500